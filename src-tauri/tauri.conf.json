{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Navi",
  "version": "0.1.7",
  "identifier": "com.goodlad.navi",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPLOCALDATA/**",
          "$RESOURCE/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "GoodLad",
    "copyright": "Copyright (c) 2026 GoodLad. GNU GPL v3.",
    "category": "Productivity",
    "shortDescription": "Local, private dictation that writes like you.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "resources": {
      "../ui/sounds/": "sounds/"
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAzQThCQjkxQzYyQkE2NTcKUldSWHBpdkdrYnVvQTBzeEx6dGVJOEhudGN5cXVzRW1reW9lSG56MGduRzJoVi9oaG9ERFlmdUIK",
      "endpoints": [
        "https://github.com/GoodLadTom/navi/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
